# Keepalived configuration for Wyoming Whisper with manual Boromir fallback
#
# MASTER: Rohan (this host) - priority 100
# MANUAL BACKUP: Boromir (192.168.1.21) - priority 50
# VIP: 192.168.1.54 (whisper.lan)

global_defs {
    router_id {{ ansible_hostname | upper }}_WHISPER
    script_user root
    enable_script_security
}

# weight 0 => a failing check forces FAULT and releases the VIP, so this host
# never advertises 192.168.1.54 without a listening wyoming-whisper.
vrrp_script check_whisper {
    script "/usr/bin/nc -z -w 2 127.0.0.1 {{ wyoming_whisper_port | default('10300') }}"
    interval 5
    weight 0
    fall 3
    rise 2
    timeout 3
}

vrrp_instance WHISPER {
    interface {{ keepalived_interface | default('vmbr0') }}
    state MASTER
    virtual_router_id 54
    priority 100
    nopreempt false

    # Unicast for Proxmox VM communication
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
        192.168.1.21  # boromir
    }

    virtual_ipaddress {
        192.168.1.54/24
    }

    track_script {
        check_whisper
    }
}
