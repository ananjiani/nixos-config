+// ponytail: ClipboardImage wire + image staging for one local file; generic message if this grows.
+pub fn read_clipboard_file() -> Option<ClipboardImage> {
+    for command in clipboard_file_list_commands() {
+        let Some(bytes) = read_clipboard_image_with_command(command.program, command.args) else {
+            continue;
+        };
+        let Ok(payload) = String::from_utf8(bytes) else {
+            continue;
+        };
+        if let Some(image) = clipboard_image_from_file_list(&payload) {
+            return Some(image);
+        }
+    }
+    None
+}
+
+fn clipboard_file_list_commands() -> Vec<ClipboardCommand> {
+    let mut commands = Vec::new();
+    if std::env::var_os("WAYLAND_DISPLAY").is_some() {
+        commands.push(ClipboardCommand {
+            program: "wl-paste",
+            args: &["--type", "x-special/gnome-copied-files"],
+        });
+        commands.push(ClipboardCommand {
+            program: "wl-paste",
+            args: &["--type", "text/uri-list"],
+        });
+    }
+    if std::env::var_os("DISPLAY").is_some() {
+        commands.push(ClipboardCommand {
+            program: "xclip",
+            args: &["-selection", "clipboard", "-t", "text/uri-list", "-o"],
+        });
+    }
+    commands
+}
+
+fn clipboard_image_from_file_list(payload: &str) -> Option<ClipboardImage> {
+    read_clipboard_file_path(parse_single_clipboard_file_path(payload)?)
+}
+
+fn parse_single_clipboard_file_path(payload: &str) -> Option<PathBuf> {
+    let mut path = None;
+    for line in payload.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        if path.is_none() && (line.eq_ignore_ascii_case("copy") || line.eq_ignore_ascii_case("cut"))
+        {
+            continue;
+        }
+        if path.is_some() {
+            return None;
+        }
+        path = Some(file_uri_to_local_path(line)?);
+    }
+    path
+}
+
+fn file_uri_to_local_path(uri: &str) -> Option<PathBuf> {
+    if uri.len() < 7 || !uri.is_char_boundary(7) || !uri[..7].eq_ignore_ascii_case("file://") {
+        return None;
+    }
+    let rest = &uri[7..];
+    let (host, path) = if rest.starts_with('/') {
+        ("", rest)
+    } else {
+        let slash = rest.find('/')?;
+        (&rest[..slash], &rest[slash..])
+    };
+    if !host.is_empty() && !host.eq_ignore_ascii_case("localhost") {
+        return None;
+    }
+    let decoded = percent_decode(path)?;
+    if decoded.contains(&0) || !decoded.starts_with(b"/") {
+        return None;
+    }
+    Some(PathBuf::from(OsString::from_vec(decoded)))
+}
+
+fn percent_decode(input: &str) -> Option<Vec<u8>> {
+    let bytes = input.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'%' => {
+                let hi = *bytes.get(i + 1)?;
+                let lo = *bytes.get(i + 2)?;
+                out.push((hex_digit(hi)? << 4) | hex_digit(lo)?);
+                i += 3;
+            }
+            byte => {
+                out.push(byte);
+                i += 1;
+            }
+        }
+    }
+    Some(out)
+}
+
+fn hex_digit(byte: u8) -> Option<u8> {
+    match byte {
+        b'0'..=b'9' => Some(byte - b'0'),
+        b'a'..=b'f' => Some(byte - b'a' + 10),
+        b'A'..=b'F' => Some(byte - b'A' + 10),
+        _ => None,
+    }
+}
+
+fn read_clipboard_file_path(path: PathBuf) -> Option<ClipboardImage> {
+    let metadata = std::fs::metadata(&path).ok()?;
+    if !metadata.is_file() || metadata.len() == 0 {
+        return None;
+    }
+    if metadata.len() > crate::protocol::MAX_CLIPBOARD_IMAGE_PAYLOAD as u64 {
+        return None;
+    }
+    let file = std::fs::File::open(&path).ok()?;
+    let bytes =
+        match read_limited_reader(file, crate::protocol::MAX_CLIPBOARD_IMAGE_PAYLOAD).ok()? {
+            LimitedRead::Complete(bytes) if !bytes.is_empty() => bytes,
+            _ => return None,
+        };
+    Some(ClipboardImage {
+        bytes,
+        extension: path
+            .extension()
+            .and_then(|ext| ext.to_str())
+            .unwrap_or("")
+            .to_string(),
+    })
+}
