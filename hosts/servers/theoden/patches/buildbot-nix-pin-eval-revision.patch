diff --git a/buildbot_nix/tests/test_eval_flake.py b/buildbot_nix/tests/test_eval_flake.py
new file mode 100644
index 0000000..38c461c
--- /dev/null
+++ b/buildbot_nix/tests/test_eval_flake.py
@@ -0,0 +1,141 @@
+"""Pin nix-eval-jobs flake URL to worker git HEAD, never got_revision."""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+from buildbot.plugins import util
+
+from buildbot_nix.eval_flake import pinned_eval_flake_arg
+from buildbot_nix.nix_eval import NixEvalCommand
+from buildbot_nix.repo_config import BranchConfig
+
+MAIN_HEAD = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+PR_HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+MERGE_HEAD = "cccccccccccccccccccccccccccccccccccccccc"
+UNPINNED = ".#checks"
+
+
+class FakeCmd:
+    def __init__(self, stdout: str | None = "", *, result: int) -> None:
+        self.stdout = stdout
+        self._result = result
+
+    def results(self) -> int:
+        return self._result
+
+
+class FakeEvalStep:
+    _worker_head_flake_arg = NixEvalCommand._worker_head_flake_arg
+
+    def __init__(self, head_cmd: FakeCmd) -> None:
+        self.command: Any = ["sentinel-eval-command"]
+        self.descriptionDone: Any = None
+        self.drv_gcroots_dir = "/tmp/gcroots"
+        self.nix_eval_config = SimpleNamespace(
+            worker_count=1,
+            max_memory_size=1024,
+            show_trace=False,
+        )
+        self.got_revision = PR_HEAD
+        self.remote_commands: list[list[str]] = []
+        self._head_cmd = head_cmd
+        self._eval_cmds: list[FakeCmd] = []
+
+        async def make_remote_shell_command(**kwargs: Any) -> FakeCmd:
+            command = list(kwargs["command"])
+            self.command = command
+            self.remote_commands.append(command)
+            if command[:3] == ["git", "rev-parse", "HEAD"]:
+                return self._head_cmd
+            cmd = FakeCmd(result=util.FAILURE)
+            self._eval_cmds.append(cmd)
+            return cmd
+
+        async def run_command(_cmd: FakeCmd) -> None:
+            return None
+
+        async def process_warnings(
+            result: int, **_kwargs: Any
+        ) -> int:
+            return result
+
+        self.makeRemoteShellCommand = make_remote_shell_command
+        self.runCommand = run_command
+        self._process_warnings = process_warnings
+
+    def getProperty(self, name: str, default: Any = None) -> Any:  # noqa: N802
+        if name == "got_revision":
+            return self.got_revision
+        return default
+
+
+@pytest.mark.parametrize(
+    ("stdout", "success"),
+    [
+        ("", True),
+        ("\n", True),
+        ("HEAD", True),
+        ("not-a-sha", True),
+        (MAIN_HEAD.upper(), True),
+        (MAIN_HEAD[:39], True),
+        (MAIN_HEAD + "0", True),
+        (f"{MAIN_HEAD}\n{PR_HEAD}", True),
+        (None, True),
+        (MAIN_HEAD, False),
+        (None, False),
+    ],
+)
+def test_pinned_eval_flake_arg_malformed(
+    stdout: str | None, success: bool
+) -> None:
+    assert pinned_eval_flake_arg(".", "checks", stdout, success=success) is None
+
+
+def _run_eval(head_cmd: FakeCmd) -> tuple[int, FakeEvalStep]:
+    step = FakeEvalStep(head_cmd)
+    result = asyncio.run(
+        NixEvalCommand._run_nix_eval_jobs(step, BranchConfig())
+    )
+    return result, step
+
+
+def test_run_nix_eval_jobs_pins_worker_head_not_got_revision() -> None:
+    result, step = _run_eval(FakeCmd(f"{MERGE_HEAD}\n", result=util.SUCCESS))
+    assert result == util.FAILURE  # nix-eval-jobs stub fails after pin
+    assert step.remote_commands[0] == ["git", "rev-parse", "HEAD"]
+    assert len(step.remote_commands) == 2
+    eval_cmd = step.remote_commands[1]
+    assert eval_cmd[0] == "nix-eval-jobs"
+    flake_arg = eval_cmd[eval_cmd.index("--flake") + 1]
+    assert flake_arg == f".?rev={MERGE_HEAD}#checks"
+    assert UNPINNED not in eval_cmd
+    assert PR_HEAD not in flake_arg
+    assert MAIN_HEAD not in flake_arg
+    assert "path:" not in flake_arg
+    assert "dir=" not in flake_arg
+    assert step.getProperty("got_revision") == PR_HEAD
+    assert step.got_revision == PR_HEAD
+
+
+@pytest.mark.parametrize(
+    "head_cmd",
+    [
+        FakeCmd(f"{MERGE_HEAD}\n", result=util.FAILURE),
+        FakeCmd("not-a-sha", result=util.SUCCESS),
+        FakeCmd("", result=util.SUCCESS),
+        FakeCmd(None, result=util.SUCCESS),
+    ],
+)
+def test_run_nix_eval_jobs_bad_head_exits_before_eval(
+    head_cmd: FakeCmd,
+) -> None:
+    result, step = _run_eval(head_cmd)
+    assert result == util.FAILURE
+    assert step.remote_commands == [["git", "rev-parse", "HEAD"]]
+    assert step._eval_cmds == []
+    assert step.command == ["sentinel-eval-command"]
+    assert step.getProperty("got_revision") == PR_HEAD
