From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ammar <ammar@example.com>
Date: Sat, 5 Sep 2026 00:00:00 -0500
Subject: [PATCH] nix_eval: pin flake eval to worker git HEAD

nix-eval-jobs --flake '.#checks' locks the workdir with an accessor that
omits empty gitlink directories. Workers refetch the explicit git revision
and include those dirs, so root narHash mismatches (cold eval fails, warm
retry passes). Pin --flake to `{flake_dir}?rev=<worker HEAD>#<attribute>`.
got_revision is the PR head, not the GitLocalPrMerge commit; read HEAD on
the worker after checkout. Fail the step if HEAD is missing or malformed.

diff --git a/buildbot_nix/eval_flake.py b/buildbot_nix/eval_flake.py
new file mode 100644
index 0000000..55e4dcd
--- /dev/null
+++ b/buildbot_nix/eval_flake.py
@@ -0,0 +1,26 @@
+"""Pin nix-eval-jobs flake refs to a worker git revision."""
+
+from __future__ import annotations
+
+from .path_filter import is_valid_sha
+
+
+def pinned_eval_flake_arg(
+    flake_dir: str,
+    attribute: str,
+    stdout: str | None,
+    *,
+    success: bool,
+) -> str | None:
+    """Return a revision-pinned flake installable, or None to fail the step.
+
+    None means fail the eval. Never fall back to an unpinned flake, and never
+    use got_revision (PR head, not merge HEAD). `{flake_dir}?rev=...#attr`
+    works for `.` and subdirs. Do not use `path:` or `dir=`.
+    """
+    if not success or not stdout:
+        return None
+    revision = stdout.strip()
+    if not is_valid_sha(revision):
+        return None
+    return f"{flake_dir}?rev={revision}#{attribute}"
