+    async def _worker_head_flake_arg(
+        self, branch_config: BranchConfig
+    ) -> str | None:
+        """Pin eval to the worker checkout HEAD after GitLocalPrMerge.
+
+        got_revision is the PR head, not the synthetic merge commit.
+        """
+        saved_command = getattr(self, "command", None)
+        cmd = await self.makeRemoteShellCommand(
+            collectStdout=True,
+            collectStderr=True,
+            stdioLogName=None,  # type: ignore[arg-type]
+            command=["git", "rev-parse", "HEAD"],
+        )
+        self.command = saved_command
+        await self.runCommand(cmd)
+        return pinned_eval_flake_arg(
+            branch_config.flake_dir,
+            branch_config.attribute,
+            cmd.stdout,
+            success=cmd.results() == util.SUCCESS,
+        )
+
     async def _should_skip_non_nix_pr(self) -> bool:
         """Skip Nix eval/build for Gitea PRs that only touch docs/ or only k8s/.

@@ -317,7 +341,13 @@ class NixEvalCommand(buildstep.ShellMixin, steps.BuildStep):

     async def _run_nix_eval_jobs(self, branch_config: BranchConfig) -> int:
         """Run nix-eval-jobs and process the results."""
-        # run nix-eval-jobs --flake .#checks to generate the dict of stages
+        flake_arg = await self._worker_head_flake_arg(branch_config)
+        if flake_arg is None:
+            self.descriptionDone = ["failed to pin flake revision"]
+            log.error("failed to pin flake eval to worker git HEAD")
+            return util.FAILURE
+
