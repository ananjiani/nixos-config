diff --git a/buildbot_nix/path_filter.py b/buildbot_nix/path_filter.py
new file mode 100644
index 0000000..6f74c74
--- /dev/null
+++ b/buildbot_nix/path_filter.py
@@ -0,0 +1,69 @@
+"""Skip Nix CI when a PR changes only docs/ or only k8s/."""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import re
+
+SKIP_STATUS_TEXT = "Skipped: no Nix-impacting files"
+
+_SHA_RE = re.compile(r"^[0-9a-f]{40}$")
+
+
+def is_valid_sha(value: object) -> bool:
+    """Accept only lowercase 40-char hex SHA strings. Anything else fails open."""
+    return isinstance(value, str) and _SHA_RE.fullmatch(value) is not None
+
+
+def should_skip_nix_ci(paths: list[str]) -> bool:
+    """Return True only when every path is under docs/ or every path is under k8s/.
+
+    Empty lists fail open (return False). Mixed docs+k8s fails open. Any other
+    path fails open.
+    """
+    if not paths:
+        return False
+    if all(path.startswith("docs/") for path in paths):
+        return True
+    return all(path.startswith("k8s/") for path in paths)
+
+
+def parse_nul_paths(raw: str) -> list[str] | None:
+    """Parse `git diff -z --name-only` stdout.
+
+    Empty output is valid (no changed paths). Non-empty output must end with a
+    trailing NUL. Empty path segments or Unicode replacement characters are
+    treated as malformed so callers can fail open.
+    """
+    if raw == "":
+        return []
+    if not raw.endswith("\0"):
+        return None
+    parts = raw.split("\0")[:-1]
+    paths: list[str] = []
+    for part in parts:
+        if part == "" or "\ufffd" in part:
+            return None
+        paths.append(part)
+    return paths
+
+
+def decode_changed_paths(raw: str) -> list[str] | None:
+    """Decode worker base64 (`git diff -z | base64`) stdout into paths.
+
+    Joins line breaks from GNU base64 wrapping / Buildbot transport. Rejects
+    non-base64, invalid UTF-8, or malformed NUL path lists (returns None).
+    """
+    compact = "".join(raw.splitlines())
+    if compact == "":
+        return []
+    try:
+        data = base64.b64decode(compact, validate=True)
+    except binascii.Error:
+        return None
+    try:
+        text = data.decode("utf-8")
+    except UnicodeDecodeError:
+        return None
+    return parse_nul_paths(text)
diff --git a/buildbot_nix/tests/test_path_filter.py b/buildbot_nix/tests/test_path_filter.py
new file mode 100644
index 0000000..70a466c
--- /dev/null
+++ b/buildbot_nix/tests/test_path_filter.py
@@ -0,0 +1,151 @@
+"""Unit tests for docs-only / k8s-only Nix CI path filter."""
+
+from __future__ import annotations
+
+import base64
+
+import pytest
+
+from buildbot_nix.path_filter import (
+    SKIP_STATUS_TEXT,
+    decode_changed_paths,
+    is_valid_sha,
+    parse_nul_paths,
+    should_skip_nix_ci,
+)
+
+
+def _b64(data: bytes) -> str:
+    """GNU/coreutils-style wrapped base64 (76 cols + trailing newline)."""
+    return base64.encodebytes(data).decode()
+
+
+def test_docs_only_skips() -> None:
+    assert should_skip_nix_ci(["docs/a.md", "docs/guide/b.md"]) is True
+
+
+def test_k8s_only_skips() -> None:
+    assert should_skip_nix_ci(["k8s/apps/foo.yaml"]) is True
+
+
+def test_docs_and_k8s_runs() -> None:
+    assert should_skip_nix_ci(["docs/a.md", "k8s/foo.yaml"]) is False
+
+
+def test_nix_path_runs() -> None:
+    assert should_skip_nix_ci(["flake.nix"]) is False
+    assert should_skip_nix_ci(["docs/a.md", "hosts/theoden/configuration.nix"]) is False
+
+
+def test_empty_runs() -> None:
+    assert should_skip_nix_ci([]) is False
+
+
+def test_skip_status_text() -> None:
+    assert SKIP_STATUS_TEXT == "Skipped: no Nix-impacting files"
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("0" * 40, True),
+        ("g" * 40, False),
+        ("0123456789abcdef0123456789abcdef01234567", True),
+        ("0123456789ABCDEF0123456789ABCDEF01234567", False),
+        ("0123456789abcdef0123456789abcdef0123456", False),
+        ("0123456789abcdef0123456789abcdef012345678", False),
+        ("0123456789abcdef0123456789abcdef0123456g", False),
+        ("", False),
+        (None, False),
+        (0, False),
+        (True, False),
+        (b"0" * 40, False),
+    ],
+)
+def test_is_valid_sha(value: object, expected: bool) -> None:
+    assert is_valid_sha(value) is expected
+
+
+def test_parse_nul_paths_trailing_nul() -> None:
+    assert parse_nul_paths("docs/a.md\0") == ["docs/a.md"]
+    assert parse_nul_paths("docs/a.md\0k8s/b.yaml\0") == ["docs/a.md", "k8s/b.yaml"]
+
+
+def test_parse_nul_paths_missing_trailing_nul() -> None:
+    assert parse_nul_paths("docs/a.md") is None
+    assert parse_nul_paths("docs/a.md\0k8s/b.yaml") is None
+
+
+def test_parse_nul_paths_spaces_newlines_unicode() -> None:
+    assert parse_nul_paths("docs/a b.md\0") == ["docs/a b.md"]
+    assert parse_nul_paths("docs/a\nb.md\0") == ["docs/a\nb.md"]
+    assert parse_nul_paths("docs/ü.md\0") == ["docs/ü.md"]
+
+
+def test_parse_nul_paths_empty_and_malformed() -> None:
+    assert parse_nul_paths("") == []
+    assert parse_nul_paths("\0") is None
+    assert parse_nul_paths("docs/a.md\0\0") is None
+    assert parse_nul_paths("docs/\ufffd.md\0") is None
+
+
+def test_decode_wrapped_base64_with_buildbot_newline() -> None:
+    payload = _b64(b"docs/a.md\0") + "\n"
+    assert "\n" in payload
+    assert decode_changed_paths(payload) == ["docs/a.md"]
+
+
+def test_decode_empty_output() -> None:
+    assert decode_changed_paths("") == []
+    assert decode_changed_paths("\n") == []
+
+
+def test_decode_malformed_and_truncated_base64() -> None:
+    assert decode_changed_paths("!!!!") is None
+    assert decode_changed_paths("ZG9jc") is None
+    assert decode_changed_paths("ZG9jcy") is None
+
+
+def test_decode_invalid_utf8() -> None:
+    assert decode_changed_paths(_b64(b"\xff\0")) is None
+
+
+def test_decode_missing_trailing_nul() -> None:
+    assert decode_changed_paths(_b64(b"docs/a.md")) is None
+
+
+def test_decode_spaces_newlines_unicode() -> None:
+    assert decode_changed_paths(_b64(b"docs/a b.md\0")) == ["docs/a b.md"]
+    assert decode_changed_paths(_b64(b"docs/a\nb.md\0")) == ["docs/a\nb.md"]
+    assert decode_changed_paths(_b64(b"docs/\xc3\xbc.md\0")) == ["docs/ü.md"]
+
+
+def test_decode_rename_emits_both_paths_and_runs() -> None:
+    # --no-renames: flake.nix -> docs/flake.nix yields both old and new paths.
+    paths = decode_changed_paths(_b64(b"flake.nix\0docs/flake.nix\0"))
+    assert paths == ["flake.nix", "docs/flake.nix"]
+    assert should_skip_nix_ci(paths) is False
+
+
+def test_decode_large_payload_with_flake_runs() -> None:
+    n_docs = 1200
+    parts = [f"docs/file{i:04d}.md\0".encode() for i in range(n_docs)]
+    parts.insert(n_docs // 2, b"flake.nix\0")
+    blob = b"".join(parts)
+    payload = _b64(blob)
+    assert len(payload) > 16 * 1024
+    paths = decode_changed_paths(payload)
+    assert paths is not None
+    assert "flake.nix" in paths
+    assert should_skip_nix_ci(paths) is False
+
+
+def test_decode_large_docs_only_skips() -> None:
+    n_docs = 1200
+    blob = b"".join(f"docs/file{i:04d}.md\0".encode() for i in range(n_docs))
+    payload = _b64(blob)
+    assert len(payload) > 16 * 1024
+    paths = decode_changed_paths(payload)
+    assert paths is not None
+    assert len(paths) == n_docs
+    assert should_skip_nix_ci(paths) is True
